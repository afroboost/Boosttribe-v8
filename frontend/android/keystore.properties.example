# Modèle de configuration de signature release Android.
#
# Copier ce fichier en `keystore.properties` (DANS CE MÊME DOSSIER frontend/android/)
# et y mettre les vraies valeurs. `keystore.properties` est gitignoré : il ne doit
# JAMAIS être committé, pas plus que le fichier .keystore lui-même.
#
# storeFile est résolu depuis frontend/android/app/ (emplacement du keystore créé
# par keytool). Voir la procédure dans le README ou le commit de mise en place.

storeFile=boosttribe-release.keystore
storePassword=CHANGEZ_MOI
keyAlias=boosttribe
keyPassword=CHANGEZ_MOI
